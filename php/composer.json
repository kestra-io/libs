{
  "name": "kestra-io/libs",
  "description": "Kestra library to send outputs, metrics, assets, and logs from PHP script tasks.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Kestra",
      "email": "hello@kestra.io",
      "homepage": "https://kestra.io"
    }
  ],
  "homepage": "https://github.com/kestra-io/libs",
  "keywords": [
    "kestra",
    "orchestration",
    "pipeline",
    "workflow",
    "metrics",
    "outputs"
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Kestra\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kestra\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
